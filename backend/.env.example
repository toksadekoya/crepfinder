NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crepfinder
DATABASE_DIRECT_URL=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_STORE=memory
COOKIE_SAME_SITE=lax
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3001
ALLOWED_ORIGINS=
SERVE_FRONTEND=false
ENABLE_RESEARCH_ROUTES=false
ALLOW_PRODUCTION_SEED=false
RESEARCH_EXPORT_TOKEN=
SOCIAL_VERIFICATION_ADMIN_TOKEN=replace-with-admin-token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback
