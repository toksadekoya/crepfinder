# Production template for the single-origin Railway deployment.
NODE_ENV=production
PORT=3001
SERVE_FRONTEND=true

# Use the pooled Neon URL at runtime and the direct URL for schema preparation.
DATABASE_URL=postgresql://user:password@host-pooler.example/dbname?sslmode=require
DATABASE_DIRECT_URL=postgresql://user:password@host.example/dbname?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Generate independent values; never reuse these examples.
SESSION_SECRET=
SESSION_STORE=postgres
COOKIE_SAME_SITE=lax
SOCIAL_VERIFICATION_ADMIN_TOKEN=

# For the single-origin deployment, both values are the same Railway HTTPS URL.
FRONTEND_ORIGIN=https://your-crepfinder-domain.example
BACKEND_PUBLIC_URL=https://your-crepfinder-domain.example
ALLOWED_ORIGINS=

ENABLE_RESEARCH_ROUTES=false
ALLOW_PRODUCTION_SEED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-crepfinder-domain.example/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=https://your-crepfinder-domain.example/api/auth/linkedin/callback
